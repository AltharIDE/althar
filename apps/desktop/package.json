{
  "name": "@althar/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Althar's desktop app: Electron, with the runtime in a utility process and the interface in the window.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "vp build --config vite.node.config.ts && vp build --config vite.preload.config.ts && vp build",
    "build:package": "vp build --config vite.node.config.ts --mode package && vp build --config vite.preload.config.ts && vp build",
    "start": "electron .",
    "dev": "bun run build && electron .",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "bun run build && playwright test",
    "verify": "bun run check && bun run test:coverage && bun run test:e2e",
    "package": "bun run build:package && node scripts/package.ts"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.84.0",
    "@agentclientprotocol/codex-acp": "2.1.1",
    "@althar/connectors": "workspace:*",
    "@althar/contracts": "workspace:*",
    "@althar/provider-adapters": "workspace:*",
    "@althar/runtime": "workspace:*",
    "@althar/ui": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.40",
    "effect": "4.0.0-rc.118",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.118",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "electron": "44.5.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
    "vite-plus": "1.0.0-rc.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "productName": "Althar"
}
