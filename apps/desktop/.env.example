# Usage data's PostHog project (src/main/usageData.ts), for `bun run package` and `bun run release`.
# Only a packaged build reads these; every other build sends nothing. Copy to .env, which git ignores.
ALTHAR_POSTHOG_KEY=phc_...
ALTHAR_POSTHOG_HOST=https://us.i.posthog.com

# Optional override for Althar's bundled public OAuth app ID for Copilot. No client secret.
# A replacement application must have device flow enabled.
ALTHAR_COPILOT_CLIENT_ID=

# The public ids of Althar's own apps, for signing in through the browser. None is a secret; empty, the service
# offers gh's or glab's sign-in and a pasted token. GitHub's is its App's client id, with the App's slug.
ALTHAR_GITHUB_CLIENT_ID=
ALTHAR_GITHUB_APP=
ALTHAR_GITLAB_CLIENT_ID=
ALTHAR_LINEAR_CLIENT_ID=
