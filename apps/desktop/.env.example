# Usage data's PostHog project (src/main/usageData.ts), for `bun run package` and `bun run release`.
# Only a packaged build reads these; every other build sends nothing. Copy to .env, which git ignores.
ALTHAR_POSTHOG_KEY=phc_...
ALTHAR_POSTHOG_HOST=https://us.i.posthog.com

# Optional override for Althar's bundled public GitHub OAuth app ID. No client secret.
# A replacement application must have device flow enabled.
ALTHAR_COPILOT_CLIENT_ID=
