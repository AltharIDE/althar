<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      Every other executable in Althar.app, each signed on its own with
      Althar's Developer ID under the hardened runtime (ADR-024): Electron's
      helpers, Claude Code's binary and Codex's. electron-builder gives them
      all this one file, so it holds what any of them needs, and no more.
    -->
    <!-- V8 in Electron's helpers (the window, the runtime's and dictation's processes), and the JIT of Claude Code's Bun and of Codex. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Claude Code's Bun and Codex write code to memory they then run, as their own signatures allow. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!--
      Claude Code's binary carries native addons of its own, which Bun writes
      out and loads at run time: they aren't signed by Althar, as library
      validation would ask. Anthropic's own signature allows the same.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Dictation records in Electron's audio process (ADR-017). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
