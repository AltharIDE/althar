/* The phone pairing lab's parts of the load popover (C). */

/* Pair a phone, beside the eyebrow: as quiet as it */
.headLink {
  font-size: 11.5px;
}
/* no phones yet: the row that pairs one */
.add {
  color: var(--t-2);
}

/* the code, in the popover's place: a way back, then the code */
.pairing {
  width: 300px;
  gap: 14px;
  padding-bottom: 14px;
}
.back {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-left: -4px;
}
.backTo {
  display: grid;
  place-items: center;
  width: 22px;
  height: 22px;
  border-radius: 6px;
  color: var(--t-3);
}
.backTo:hover {
  background: var(--hover-faint);
  color: var(--t-1);
}
.backChevron {
  transform: rotate(180deg);
}
