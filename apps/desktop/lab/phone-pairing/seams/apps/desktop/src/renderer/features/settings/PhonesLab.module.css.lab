/* The phone pairing lab's parts of Settings › Computers. */

/* A: Add a phone, opened out, on the sheet's paper */
.pairSheet {
  padding: 22px 22px 20px;
}

/* B: the home's phones, under its Agents at once, set off by the sheet's own rule */
.homePhones {
  display: grid;
  gap: 8px;
  margin: 0 -20px;
  padding: 14px 20px 16px;
  border-top: 1px solid var(--line);
}
.homePhonesHead {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
}
.homePhonesTitle {
  font-size: 13px;
  font-weight: 500;
  color: var(--t-1);
}
.homeEmpty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
.homeEmptyWords {
  font-size: 12.5px;
  color: var(--t-3);
}
.homePhones ul {
  margin: 0 -8px;
}
