import { useQuery } from '@tanstack/react-query'
import { useState } from 'react'

import { MOST_AT_ONCE } from '@althar/contracts'
import {
  AddWorkerDialog,
  AgentsAtOnce,
  Button,
  Computers,
  ControlDetail,
  Dialog,
  fewerOf,
  LinkButton,
  Problem,
  SettingGroup,
  SettingList,
} from '@althar/ui'

import { Pairing } from '@lab/pairing/Pairing'
import { PhoneModule, PhoneRows, PhoneSheet } from '@lab/pairing/Phones'
import { usePhones } from '@lab/pairing/world'
import { useLab } from '@lab/state'
import c from '../../../../../../packages/ui/src/setup/Computers/Computers.module.css'
import { AddTile } from '../../../../../../packages/ui/src/setup/ToolTiles/ToolParts'
import tt from '../../../../../../packages/ui/src/setup/ToolTiles/ToolTiles.module.css'
import { useServices } from '../../data/services'
import { device } from '../../shared/device'
import { usePlaces } from '../../shared/usePlaces'
import { computerWorkerOf, useRemoveWorker, useWorkers } from '../../shared/useWorkers'
import type { StartModel } from '../start/useStart'
import { EVERY, glanceOf, SLOTS } from '../tabs/useLoad'
import s from './Settings.module.css'
import { text } from './text'
import { useAgentsAtOnce } from './useAgentsAtOnce'
import p from './PhonesLab.module.css'

/*
 * The phone pairing lab's Settings › Computers: the Computers task's section
 * as it built it, and the window's home's phones where the direction puts
 * them. A (and C) adds Phones after Workers, a module each, and Add a phone
 * opens out in place, as a worker does, to the code. B keeps phones with the
 * home: its module says how many, and opened out it lists them under its
 * Agents at once, with Pair a phone opening the code in a dialog. D leaves
 * Computers as it was: its phones are in the homes menu.
 */

/** Opened out: Add a phone, in place. */
const PAIR = 'pair'
const HOME = 'home'

export function ComputersSection({
  start,
  opened: asked,
  onOpen,
  onTask,
}: {
  start: StartModel
  opened: string | null
  onOpen: (id: string | null) => void
  onTask?: ((threadId: string) => void) | undefined
}) {
  // The hash router reads the lab's own address (?d=…) into the last search value: only what comes before it.
  const opened = asked === null ? null : (asked.split('?')[0] ?? null)
  const { client } = useServices()
  const { d } = useLab()
  const { home, list: phoneList } = usePhones()
  const reading = useQuery({
    queryKey: ['load'],
    queryFn: () => client.getLoad(),
    refetchInterval: EVERY,
    refetchIntervalInBackground: false,
    staleTime: 0,
    retry: false,
  })
  const places = usePlaces(true)
  const workers = useWorkers(true)
  const removing = useRemoveWorker()
  const atOnce = useAgentsAtOnce()
  const [adding, setAdding] = useState(false)
  const [pairing, setPairing] = useState(false)
  const names = new Map((start.status?.agents ?? []).map((agent) => [agent.id, agent.name]))
  const homeName = home.key === 'mac' ? device.This : home.name
  const besideWorkers = d === 'a' || d === 'c'
  const withHome = d === 'b'
  const phone = phoneList.find((one) => one.id === opened)

  if (besideWorkers && opened === PAIR)
    return (
      <div className={c.computers}>
        <div className={tt.opened}>
          <ControlDetail title="Add a phone" onBack={() => onOpen(null)} text={{ back: 'Computers' }} aside={homeName}>
            <div className={`${tt.sheet} ${p.pairSheet}`}>
              <Pairing layout="wide" onDone={() => onOpen(null)} />
            </div>
          </ControlDetail>
        </div>
      </div>
    )
  if ((besideWorkers || withHome) && phone !== undefined)
    return (
      <div className={c.computers}>
        <PhoneSheet home={{ ...home, name: homeName }} phone={phone} onBack={() => onOpen(withHome ? HOME : null)} back={withHome ? homeName : 'Computers'} />
      </div>
    )

  const agentsAtOnce =
    atOnce === null ? null : (
      <AgentsAtOnce
        count={atOnce.atOnce.count}
        own={atOnce.atOnce.own !== null}
        machine={atOnce.atOnce.machine}
        most={MOST_AT_ONCE}
        onChange={atOnce.set}
        fewer={places === null ? null : fewerOf(places)}
        text={{ note: text.atOnceNote, mark: text.atOnceMark, value: text.atOnceValue }}
      />
    )
  // B: the home's own phones, under its Agents at once.
  const homePhones = (
    <div className={p.homePhones}>
      <span className={p.homePhonesHead}>
        <span className={p.homePhonesTitle}>Phones</span>
        {phoneList.length > 0 && <LinkButton onClick={() => setPairing(true)}>Pair a phone</LinkButton>}
      </span>
      {phoneList.length === 0 ? (
        <span className={p.homeEmpty}>
          <span className={p.homeEmptyWords}>Open {homeName}’s projects and tasks on your phone.</span>
          <Button onClick={() => setPairing(true)}>Pair a phone</Button>
        </span>
      ) : (
        <PhoneRows home={{ ...home, name: homeName }} list={phoneList} onOpen={(id) => onOpen(id)} />
      )}
    </div>
  )

  return (
    <>
      <Computers
        home={{ name: homeName, load: reading.data === undefined ? null : glanceOf(reading.data), agents: places }}
        workers={
          workers === null
            ? null
            : { enabled: workers.enabled, list: workers.workers.map((one) => computerWorkerOf(one, (id) => names.get(id) ?? id)) }
        }
        opened={opened}
        onOpen={onOpen}
        onAdd={() => setAdding(true)}
        onRemove={(id) => {
          onOpen(null)
          removing.remove(id)
        }}
        onTask={onTask}
        homeSettings={
          withHome ? (
            <>
              {agentsAtOnce !== null && <SettingList>{agentsAtOnce}</SettingList>}
              {homePhones}
            </>
          ) : agentsAtOnce === null ? null : (
            <SettingList>{agentsAtOnce}</SettingList>
          )
        }
        slots={SLOTS}
        {...(withHome
          ? { text: { homeLine: phoneList.length === 0 ? 'Keeps your projects' : `Keeps your projects · Opens on ${phoneList.length === 1 ? '1 phone' : `${phoneList.length} phones`}` } }
          : {})}
      />
      {besideWorkers && opened === null && (
        <SettingGroup
          className={c.group}
          title="Phones"
          {...(phoneList.length > 0 ? { action: <LinkButton onClick={() => onOpen(PAIR)}>Add a phone</LinkButton> } : {})}
        >
          <div className={c.grid}>
            {phoneList.length === 0 ? (
              <AddTile onClick={() => onOpen(PAIR)} className={c.add}>
                <span className={c.addWords}>
                  <span>Add a phone</span>
                  <span className={c.addLine}>Open {homeName}’s projects and tasks on it</span>
                </span>
              </AddTile>
            ) : (
              phoneList.map((one) => <PhoneModule key={one.id} phone={one} onOpen={() => onOpen(one.id)} />)
            )}
          </div>
        </SettingGroup>
      )}
      {removing.failed !== null && <Problem className={s.failed}>{removing.failed}</Problem>}
      {atOnce?.failed === true && <Problem className={s.failed}>{text.failed}</Problem>}
      {adding && <AddWorkerDialog home={homeName} enabled={workers?.enabled ?? false} onClose={() => setAdding(false)} />}
      {pairing && (
        <Dialog title={`Pair a phone with ${homeName}`} onClose={() => setPairing(false)} width={640}>
          <Pairing layout="wide" onDone={() => setPairing(false)} />
        </Dialog>
      )}
    </>
  )
}
