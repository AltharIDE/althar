{
  "name": "@althar/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Althar on a phone: what needs you, what's at work, and answering for you, paired with the Mac that runs Althar.",
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "shots": "node scripts/shots.mjs",
    "lint": "cd ../.. && vp lint apps/mobile/src apps/mobile/tests && vp fmt --check apps/mobile/src apps/mobile/tests apps/mobile/scripts",
    "fix": "cd ../.. && vp lint --fix apps/mobile/src apps/mobile/tests && vp fmt apps/mobile/src apps/mobile/tests apps/mobile/scripts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/metro-runtime": "~58.0.14",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~58.0.16",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "iconoir-react-native": "^7.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "playwright-core": "1.56.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
