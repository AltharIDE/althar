{
  "name": "@althar/site",
  "version": "0.0.0",
  "private": true,
  "description": "Althar's site: the developer page, the shifts and the thesis, built with Vite+ and @althar/ui.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && vp build --ssr src/entry-server.tsx --outDir .ssr && bun scripts/prerender.ts && bun scripts/test-built.ts",
    "preview": "vp preview",
    "deploy": "bun run build && wrangler deploy",
    "check": "vp check",
    "test": "vp test run",
    "fix": "vp check --fix",
    "og": "bun scripts/og.ts"
  },
  "dependencies": {
    "@althar/ui": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@althar/testing": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "wrangler": "^4.156.1"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
