{
  // The site on Cloudflare: static assets only, no Worker code. `bun run build`
  // writes dist/, with thesis/index.html for the thesis; any other path gets the
  // landing page.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "althar-site",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
}
