{
  "name": "@althar/report",
  "version": "0.0.0",
  "private": true,
  "description": "A Cloudflare Worker that turns a problem report sent from the app into an issue in Linear.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "verify": "bun run check && bun run test:coverage",
    "fake-linear": "bun scripts/fake-linear.ts"
  },
  "devDependencies": {
    "@althar/testing": "workspace:*",
    "@types/bun": "^1.3.5",
    "@vitest/coverage-v8": "5.0.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
    "vite-plus": "1.0.0-rc.0",
    "vitest": "5.0.1",
    "wrangler": "^4.143.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
