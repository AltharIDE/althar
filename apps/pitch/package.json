{
  "name": "@althar/pitch",
  "version": "1.0.0",
  "private": true,
  "description": "Althar's investor brief and research note: a static site built with Vite+.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && vp build --ssr src/entry-server.tsx --outDir .ssr && bun scripts/prerender.ts && bun scripts/budget.ts",
    "preview": "vp preview",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "images": "bun scripts/images.ts",
    "verify": "bun run check && bun run test:coverage && bun run build && bun run test:e2e",
    "test:coverage": "vp test run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
    "vite-plus": "1.0.0-rc.0",
    "vitest": "5.0.1",
    "wrangler": "^4.143.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
