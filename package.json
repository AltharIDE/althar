{
  "name": "althar",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "brand"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --filter @althar/site dev",
    "site": "bun --filter @althar/site dev",
    "build": "bun --filter '*' build",
    "check": "bun --filter '*' check",
    "test": "bun --filter '*' test",
    "test:e2e": "bun --filter '*' test:e2e",
    "verify": "bun --filter '*' verify",
    "prepare": "vp config --no-agent",
    "fix": "bun --filter '*' fix"
  },
  "devDependencies": {
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "@posthog/core": "1.62.0",
    "@posthog/types": "1.419.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "engines": {
    "bun": ">=1.3.5",
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.3.5",
  "patchedDependencies": {
    "@agentclientprotocol/claude-agent-acp@0.99.1": "patches/@agentclientprotocol%2Fclaude-agent-acp@0.99.1.patch"
  },
  "trustedDependencies": [
    "electron",
    "sharp"
  ]
}
