    "subscriptions_url": "https://api.github.com/users/balazsotakomaiya/subscriptions",
    "organizations_url": "https://api.github.com/users/balazsotakomaiya/orgs",
    "repos_url": "https://api.github.com/users/balazsotakomaiya/repos",
    "events_url": "https://api.github.com/users/balazsotakomaiya/events{/privacy}",
