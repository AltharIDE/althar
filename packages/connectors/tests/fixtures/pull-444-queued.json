  "title": "Plan usage: fresh Claude readings, not 20-hour-old ones",
  "user": {
    "login": "balazsotakomaiya",
    "id": 34940135,
    "node_id": "MDQ6VXNlcjM0OTQwMTM1",
    "avatar_url": "https://avatars.githubusercontent.com/u/34940135?v=4",
