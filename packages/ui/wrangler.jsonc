{
  // Storybook on Cloudflare: static assets only. `bun run build` writes
  // dist/storybook.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "althar-storybook",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist/storybook",
  },
  "observability": {
    "enabled": true,
  },
}
