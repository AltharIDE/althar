{
  "name": "@althar/runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Althar's runtime: the one writer of the local store, which owns agent sessions, turns, permissions and processes.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./locations": "./src/locations.ts"
  },
  "scripts": {
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test run",
    "probe:tools": "bun scripts/probe-tools.ts",
    "test:coverage": "vp test run --coverage",
    "verify": "bun run check && bun run test:coverage",
    "test:agents": "vp test run --config vite.agents.config.ts",
    "test:memory-model": "vp test run --config vite.memory.config.ts"
  },
  "dependencies": {
    "@althar/connectors": "workspace:*",
    "@althar/contracts": "workspace:*",
    "@althar/domain": "workspace:*",
    "@althar/persistence-sqlite": "workspace:*",
    "@althar/provider-adapters": "workspace:*",
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "effect": "4.0.0-rc.118"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.118",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
    "vite-plus": "1.0.0-rc.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
